{
  "name": "neon-tetris",
  "version": "1.0.0",
  "description": "Neon Tetris - A retro-style Tetris game with neon effects",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . NeonTetris --platform=win32 --arch=x64 --out=release --overwrite --asar",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.neontetris.app",
    "productName": "Neon Tetris",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "dist/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neon Tetris"
    },
    "portable": {
      "artifactName": "NeonTetris-Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2"
  }
}
